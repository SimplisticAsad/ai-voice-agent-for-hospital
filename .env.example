# --- Hugging Face (Qwen LLM powering the voice agent via smolagents) ---
HF_TOKEN=your_huggingface_token_here
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Twilio (telephony: inbound calls, speech-to-text via <Gather>, text-to-speech via <Say>) ---
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_number_here
# Voice used for Twilio's built-in TTS (see https://www.twilio.com/docs/voice/twiml/say/text-speech)
TWILIO_TTS_VOICE=Polly.Joanna

# --- Server ---
PORT=3000

# --- Database ---
# Path to the SQLite file. Defaults to ./patients.db if unset.
DATABASE_PATH=./patients.db

# Note: Replace placeholder values with real credentials. Never commit your actual .env file.
# Twilio Console: https://console.twilio.com
# Hugging Face tokens: https://huggingface.co/settings/tokens
